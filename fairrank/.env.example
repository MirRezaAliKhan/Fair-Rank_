# Database
MONGODB_URI=mongodb://localhost:27017/fairrank
# or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fairrank

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development

# GitHub Integration (optional, for skills verification)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Clerk Authentication (optional, if using Clerk instead of JWT)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
